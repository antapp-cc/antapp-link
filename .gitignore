# 构建产物
dist/

# 第三方原始发布包：内容已提取进 internal/client/assets/wintun/，
# 这里只保留哈希与说明用于溯源，避免仓库里塞两份几 MB 的二进制。
third_party/wintun-0.14.1/
third_party/wintun-0.14.1.zip

# 误落仓库根目录的外来文件
/notifications.json
# 交叉编译产物（build 不带 -o 时落在根目录）
/antapp-linkd
/antapp-link.exe

# 单文件安装器的内嵌素材（构建时由 build.ps1 生成拷入）
cmd/antapp-setup/assets/antapp-link.exe
cmd/antapp-setup/assets/THIRD-PARTY-NOTICES.md
cloud-server-backup-20260928/

# CodeGraph 索引与运行期日志：都不是源码
/.codegraph/
/logs/

# 发布签名私钥：拿到它就能签出所有节点都接受的更新清单，绝不能进仓库
*.key
# 连接码内含私钥，等同密码，绝不入库
*.antapp
*.antapp.bak
# 独立审查/子代理留下的临时工作目录，不入库
.review-*/
