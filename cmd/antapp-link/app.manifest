<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" processorArchitecture="*" name="AntApp.AntAppLink.Client" type="win32"/>
  <description>AntApp Link</description>

  <!--
    必须显式请求 Common-Controls v6：
    1) walk 的图标加载用 LoadIconWithScaleDown，这个导出只存在于 v6；
       不加这一段，程序会在 NewIconFromFile 上直接失败。
    2) 不请求 v6 的话控件会退回 Win95 风格外观。
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="*"
                        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>

  <!-- 高 DPI 下别被系统拉伸糊掉 -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>

  <!--
    创建虚拟网卡、改路由表、写系统 DNS 都要管理员权限。
    在这里声明，UAC 会在双击时就弹出来；否则要等用户点了「连接」才失败。
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
